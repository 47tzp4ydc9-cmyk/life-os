# Copy this file to .env and fill in real values. .env is gitignored; this
# template is committed so anyone (or any future AI session) can see what
# secrets the repo expects.

GITHUB_TOKEN=

IBKR_GATEWAY_URL=
IBKR_USERNAME=
IBKR_ACCOUNT_ID=

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ---- SnapTrade (Wealthsimple + other broker aggregation) ----
# Claude reaches SnapTrade through the hosted MCP at https://mcp.snaptrade.com/mcp
# (added as a claude.ai custom connector, OAuth flow — no keys go into claude.ai).
# The four vars below are only needed if you later run LOCAL scripts against the
# SnapTrade Partner API (e.g. to populate investment-os/data/). See
# investment-os/README.md → "SnapTrade (Wealthsimple, etc.)".
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=
